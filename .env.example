# From Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional. Server-only. Enables the iOS Shortcut SMS route and full account deletion.
# Never prefix this with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Server-only. Turns on AI answers in Ask Expensly (console.anthropic.com → API keys).
ANTHROPIC_API_KEY=
# Optional: which Claude model to use (default claude-sonnet-5-5; claude-haiku-5-5 is cheaper).
ANTHROPIC_MODEL=
# Optional: only these emails (comma-separated) get AI answers. Everyone else gets basic answers.
AI_ALLOWED_EMAILS=
# Optional limits when people use the app's own key above (defaults: 30/day, 5/minute, 1.5M tokens/month):
AI_DAILY_LIMIT=
AI_PER_MINUTE=
AI_MONTHLY_TOKENS=
# Optional limits when people connect their own AI key (defaults: 200/day, 10/minute):
AI_DAILY_LIMIT_OWN=
AI_PER_MINUTE_OWN=

# Or use another AI instead of Claude: set ONE of these (the first one found is used).
# GEMINI_API_KEY=      # aistudio.google.com → Get API key (free tier)
# GROQ_API_KEY=        # console.groq.com → API keys (free, no card). With Gemini set too, Groq is the automatic backup when Gemini is out of quota or down.
# OPENAI_API_KEY=      # platform.openai.com (paid)
# OPENROUTER_API_KEY=  # openrouter.ai (free ":free" models)
# AI_MODEL=            # optional: override the default model

# Set to "on" once Google sign-in is set up in Supabase (Authentication → Sign In / Providers → Google).
AUTH_GOOGLE=

# Reminders (push notifications). `npm run setup-push` fills these in.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# CRON_SECRET=          # Vercel sends this to /api/cron/notify; any long random string

# App health: who gets the daily error report and sees Settings → App health
# OWNER_EMAIL=you@example.com
# CONTACT_EMAIL=        # optional, shown on /privacy for data requests
